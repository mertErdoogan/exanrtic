# Harita: MapTiler anahtarı (https://cloud.maptiler.com/account/keys/).
# Varsa uygulama Uydu / Arazi / Sade katmanlarını sunar. Boşsa düşük detaylı demo harita açılır.
# Anahtarı MapTiler panelinde uygulama kimliğine (com.dedektorasistani.app) kısıtla.
EXPO_PUBLIC_MAPTILER_KEY=

# İsteğe bağlı: tek bir özel stil adresi (başka bir sağlayıcı kullanmak istersen)
EXPO_PUBLIC_MAP_STYLE_URL=

# Supabase (yalnızca herkese açık anahtarlar; gizli anahtarlar asla buraya yazılmaz)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
