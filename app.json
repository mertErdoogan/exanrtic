{
  "expo": {
    "name": "Dedektör Asistanı",
    "slug": "dedektor-asistani",
    "scheme": "dedektorasistani",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dedektorasistani.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dedektorasistani.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F3EFE7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dedektör Asistanı, arama sırasında rotanı ve kazı noktalarını haritaya işlemek için konumunu kullanır.",
          "locationAlwaysAndWhenInUsePermission": "Telefon cebindeyken ve ekran kapalıyken aramanı kaydetmeye devam edebilmek için konum iznine ihtiyaç var. Konumun yalnızca telefonunda saklanır.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Buluntularının fotoğrafını çekmek için kameraya erişim gerekiyor.",
          "photosPermission": "Buluntularına galeriden fotoğraf eklemek için fotoğraflarına erişim gerekiyor.",
          "microphonePermission": "Buluntularına sesli not eklemek için mikrofona erişim gerekiyor."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Buluntularına sesli not eklemek için mikrofona erişim gerekiyor.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Sallama koçu, tekniğini ölçmek için hareket sensörlerini kullanır."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
